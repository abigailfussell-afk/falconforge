# Copy this to `.env.development.local` for local work.
#
# NOT to `.env.local` — that file points at PRODUCTION and is what the deploy uses. A build or
# script that inherits ambient environment writes to the real database; it has been caught
# before harm three separate times. See docs/environment-divergences.md §2.
#
# These are the local stack's own credentials, printed by `npm run db:start` / `supabase status`.
# They are the same on every machine and are not secret.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# No Stripe key. There is no Stripe integration — billing is entitlements only until the
# post-beta sprint (plan §3), and advertising a variable nothing reads sends the next reader
# looking for an integration that does not exist.
