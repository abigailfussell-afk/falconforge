{
  "name": "falconforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --config vitest.config.coverage.ts --coverage",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:db": "vitest run --config vitest.config.db.ts",
    "test:rls": "vitest run --config vitest.config.db.ts rls",
    "test:all": "npm run lint && npm run test:run && npm run test:integration && npm run test:db",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:verify": "supabase db reset && npm run db:assert",
    "db:assert": "docker exec -i supabase_db_falconforge psql -U postgres -d postgres -v ON_ERROR_STOP=1 -f - < supabase/tests/schema_assertions.sql",
    "db:diff": "supabase db diff --linked --schema public",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "prepare": "husky",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "capture": "node scripts/capture-screens.mjs",
    "seed:review": "node scripts/seed-review-states.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:prod": "node scripts/check-production.mjs",
    "venue": "node scripts/venue-simulation.mjs",
    "seed:demo": "node scripts/seed-demo-team.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.17.0",
    "d3": "^7.9.0",
    "dexie": "^3.2.4",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.562.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.17",
    "autoprefixer": "^10.5.4",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.3.1",
    "pg": "^8.20.0",
    "postcss": "^8.5.26",
    "supabase": "^2.114.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.4",
    "vitest": "^4.0.17",
    "workbox-window": "^7.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "vitest related --run"
    ]
  }
}
